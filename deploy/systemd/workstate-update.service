[Unit]
Description=Pull and restart workstate if a new image is published
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/workstate
ExecStart=/usr/bin/docker compose -p workstate --env-file deploy/workstate.env -f deploy/compose.prod.yml pull app
ExecStart=/usr/bin/docker compose -p workstate --env-file deploy/workstate.env -f deploy/compose.prod.yml up -d
ExecStartPost=/usr/bin/docker image prune -f --filter label=org.opencontainers.image.source=https://github.com/nvanderploeg/work-state
