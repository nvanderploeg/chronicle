# Copy to deploy/chronicle.env and chmod 600.

# Hex only: it is spliced into DATABASE_URL. openssl rand -hex 24
POSTGRES_PASSWORD=
# External Postgres over TLS: set DATABASE_URL in the compose file to
# postgres://user:pw@host:5432/chronicle?sslmode=verify-full (add sslrootcert=/path/ca.pem for a
# private CA). Run one app replica only.

ORIGIN=https://chronicle.example.com

# Enables the admin portal at /admin (export, import, delete Projects). At least 16 characters,
# no spaces; openssl rand -hex 32. Leave empty to keep /admin off (it answers 404).
ADMIN_TOKEN=
# Largest bundle an import accepts, in MiB (also sets BODY_SIZE_LIMIT). Raise nginx's
# client_max_body_size for /api/admin/import to match.
# ADMIN_MAX_BUNDLE_MB=256

CHRONICLE_IDLE_MS=14400000
CHRONICLE_HEARTBEAT_MS=25000
CHRONICLE_WRITES_PER_WINDOW=120
CHRONICLE_WRITE_WINDOW_MS=300000
